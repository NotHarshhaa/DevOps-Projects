pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "tushar31/spring-boot-app:${BUILD_NUMBER}"
    }

    stages {

        stage('Build Application') {
            steps {
                dir('DevOps-Project-18/spring-boot-app') {
                    sh 'mvn clean package'
                }
            }
        }
stage('SonarQube Analysis') {
    steps {
        script {
            def scannerHome = tool 'sonar-scanner'

            dir('DevOps-Project-18/spring-boot-app') {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([
                        string(
                            credentialsId: 'sonarqube-token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                              -Dsonar.projectKey=my-app \
                              -Dsonar.projectName=my-app \
                              -Dsonar.sources=src/main/java \
                              -Dsonar.java.binaries=target/classes \
                              -Dsonar.token=\$SONAR_TOKEN
                        """
                    }
                }
            }
        }
    }
}
stage('OWASP Dependency Check') {
    steps {
            dir('spring-boot-app') {
              sh 'mvn org.owasp:dependency-check-maven:13.0.0:check -DfailBuildOnCVSS=8'
        }        
    }
}

        stage('Build Docker Image') {
            steps {
                dir('DevOps-Project-18/spring-boot-app') {
                    sh 'docker build -t ${DOCKER_IMAGE} .'
                }
            }
        }
        stage('Trivy Image Scan') {
    steps {
        sh '''
            trivy image \
              --severity HIGH,CRITICAL \
              --exit-code 1 \
              ${DOCKER_IMAGE}
        '''
    }
}

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        docker.image("${DOCKER_IMAGE}").push()
                    }
                }
            }
        }

        stage('Deploy to AKS') {
            steps {
                sh '''
                    helm upgrade --install spring-boot-app \
                      ./DevOps-Project-18/helm/spring-boot-app \
                      --namespace project18 \
                      --create-namespace \
                      --set image.repository=tushar31/spring-boot-app \
                      --set image.tag=${BUILD_NUMBER} \
                      --wait \
                      --timeout 2m
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    kubectl get pods -n project18

                    kubectl rollout status deployment/spring-boot-app \
                      -n project18 \
                      --timeout=120s
                '''
            }
        }
    }
}